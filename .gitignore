# Recorded frames. ~3 MB each, capped at RECORD_LIMIT (3000) = ~8.5 GB.
# These are generated by running the script and are specific to one account's
# shop on one machine -- they are test *data*, not source, and they contain
# screenshots of a live game session (character name, Alz balance, listings).
unit_tests/corpus/*.png
unit_tests/corpus/run_index.jsonl

# Frozen read_rows output. Meaningless without the corpus it was measured from,
# and regenerated with `py unit_tests\baseline_rows.py save`.
unit_tests/baseline_rows.json

# Measured for one screen and one game window. Copying it to another machine is
# actively harmful: the script would click at coordinates that do not apply.
# It is re-measured automatically on every run.
calibration.json

# Output of --shot.
screenshots/*.png

__pycache__/
*.pyc

# Per-run logs. One file per invocation, named by start time. Kept out of
# git because they contain the full console output of a live session --
# item names, prices and Alz figures -- and because a crash log is only
# useful on the machine that produced it.
logs/

# Scratch directory the failure-path harness records into while it runs.
# Regenerated on every run; never part of the corpus.
unit_tests/failpaths/_recdir/

# Live sales ledger: one row per collection, written as it happens.
# Account data -- item names, prices and proceeds from a real shop.
sales.db
# Backups of the same, taken before pruning it.
sales.db.bak
sales.db.*

# Output of calibrate_probe.py: screenshots and OCR dumps of a live
# session. Generated on demand and sent by hand when diagnosing a
# machine that cannot calibrate.
calibrate_probe.png
calibrate_probe_out/

# Purchase-tab frames used by the buying tests: screenshots of a live
# market, with the account's own balance and listings in them.
unit_tests/corpus/buying/
