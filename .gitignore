# Recorded frames. ~3 MB each, capped at RECORD_LIMIT (3000) = ~8.5 GB.
# These are generated by running the script and are specific to one account's
# shop on one machine -- they are test *data*, not source, and they contain
# screenshots of a live game session (character name, Alz balance, listings).
unit_tests/corpus/*.png
unit_tests/corpus/run_index.jsonl

# Frozen read_rows output. Meaningless without the corpus it was measured from,
# and regenerated with `py unit_tests\baseline_rows.py save`.
unit_tests/baseline_rows.json

# trade.py's calibration: a flat set of coordinates with nothing recording which
# screen they came from. Copying it to another machine is actively harmful --
# the script would click at coordinates that do not apply. Re-measured on every
# run. ANCHORED to the repo root: src/calibration.json is a different file and
# IS committed. It keys every position by resolution, so another machine reads
# its own section or is refused; and its shared `timing` block only stops
# drifting silently once git can see it. It had sat at action_gap 0.5 against a
# DEFAULTS of 0.05 -- 10x every gap, unnoticed, because this line hid it.
/calibration.json

# Output of --shot.
screenshots/*.png

__pycache__/
*.pyc

# Per-run logs. One file per invocation, named by start time. Kept out of
# git because they contain the full console output of a live session --
# item names, prices and Alz figures -- and because a crash log is only
# useful on the machine that produced it.
logs/

# Scratch directory the failure-path harness records into while it runs.
# Regenerated on every run; never part of the corpus.
unit_tests/failpaths/_recdir/

# Live sales ledger: one row per collection, written as it happens.
# Account data -- item names, prices and proceeds from a real shop.
sales.db
# Backups of the same, taken before pruning it.
sales.db.bak
sales.db.*

# Output of calibrate_probe.py: screenshots and OCR dumps of a live
# session. Generated on demand and sent by hand when diagnosing a
# machine that cannot calibrate.
calibrate_probe.png
calibrate_probe_out/

# Purchase-tab frames used by the buying tests: screenshots of a live
# market, with the account's own balance and listings in them.
unit_tests/corpus/buying/

# Labelled golden frames captured alongside a live session by
# capture_goldens.py. Same reason as the rest of the corpus: they are
# screenshots of a real account's shop, inventory and balance.
unit_tests/corpus/goldens/

# Per-process scratch crops written by get_alz.
.alz_tmp*.png

# Local pre-change snapshots of trade.py. Git already keeps the history;
# committing a 1 MB copy of the file next to the file is noise.
backups/
.row1_baseline.json

# Annotated OCR boundary captures. Screenshots of a live account.
ocr_boundaries/

# Screenshots written by src/ when --frames is passed. Same reason as the
# trade.py corpus: pictures of a live account, regenerated on demand.
src/debug_frames/

# Run logs, one per launch, named for the date and what was run. Generated,
# and they hold screenshots-in-words of a live session: balances, item names,
# prices. Kept on disk so a crash can be read after the fact, not in git.
src/logs/
